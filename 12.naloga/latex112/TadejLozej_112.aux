\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Poli filtrov s katerimi smo dobili frekvenčne spektre na sliki 2. Levo so poli filtrov, ki smo jih uporabili na datoteki \texttt  {val2.dat}. Desno so poli filtrov, ki smo jih uporabili na datoteki \texttt  {val3.dat}. Vsi poli se nahajajo znotraj enotske krožnice v kompleksni ravnini kar pomeni, da so filtri stabilni.\relax }}{3}{figure.caption.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}co2.dat}{4}{subsection.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Zgornji graf z modro črto prikazuje koncentracijo ogljikovega dioksida skozi čas iz datoteke \texttt  {co2.dat}. Z oranžno in zeleno črto sta narisana prilagojen eksponentni in linearni trend. Na spodnjem grafu so prikazani kvadrati razlik med meritvami in trendoma. S črtkano črto je prikazano povprečje kvadrata razlike.\relax }}{4}{figure.caption.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Koncentracija ogljikovega dioksida skozi čas z odštetim eksponentnim trendom.\relax }}{5}{figure.caption.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Frekvenčni spektri signalov iz datotek \texttt  {val2.dat} (zgoraj) in \texttt  {val3.dat} (spodaj) pridobljeni z diskretno Fourierovo transformacijo brez okna, z Welch oknom ter po metodi maksimalne entropije za nekaj različnih redov filtra $p$.\relax }}{5}{figure.caption.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Napoved nadaljnih točk s filtri različnega reda $p$. Z modro črto so prikazane realizirane meritve z oranžno, zeleno in rdečo pa napovedi filtrov različnih redov.\relax }}{5}{figure.caption.8}\protected@file@percent }
