\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Minimalni red filtra $p$ potreben za določitev frekvenc $\omega _1$ in $\omega _2$ iz spektra nezašumljenega in treh z različnimi disperzijami zašumljenih signalov v odvisnosti od razlike dveh frekvenc.\relax }}{6}{figure.caption.10}\protected@file@percent }
